apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: backend-network-policy
  namespace: dev
spec:
  podSelector:
    matchLabels:
      app: backend

  policyTypes:
    - Ingress

  ingress:
    - from:
        - podSelector:
            matchLabels:
              app: frontend
      ports:
        - protocol: TCP
          port: 8080



For reference: selects the destination pods.
podSelector:
  matchLabels:
    app: backend

selects the source pods
from:
  - podSelector:
      matchLabels:
        app: frontend

pipeline {
    agent {
        label 'jenkinsagent'
    }

    parameters {
        string(name: 'GIT_REPO', description: 'Application Git repository')
        string(name: 'BRANCH', defaultValue: 'main')
        string(name: 'IMAGE_NAME', description: 'Docker/ECR image name')
    }

    environment {
        ECR_REPO = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${params.IMAGE_NAME}"
        IMAGE_TAG = "${BUILD_NUMBER}"
        SONAR_HOME = tool 'SonarScanner'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: "${params.BRANCH}",
                    url: "${params.GIT_REPO}"
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Unit Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('SonarQube Scan') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh """
                    mvn sonar:sonar \
                    -Dsonar.projectKey=${params.IMAGE_NAME} \
                    -Dsonar.projectName=${params.IMAGE_NAME}
                    """
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                sh 'trivy fs .'
            }
        }

        stage('Docker Build') {
            steps {
                sh """
                docker build -t ${params.IMAGE_NAME}:${IMAGE_TAG} .
                """
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """
                trivy image ${params.IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh """
                aws ecr get-login-password --region ${AWS_REGION} |
                docker login --username AWS --password-stdin \
                ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                docker tag ${params.IMAGE_NAME}:${IMAGE_TAG} \
                ${ECR_REPO}:${IMAGE_TAG}

                docker push ${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }

        stage('Update Deployment Git Repository') {
            steps {
                sh """
                git clone https://github.com/your-company/deployment-repo.git
                cd deployment-repo

                sed -i 's/tag:.*/tag: "${IMAGE_TAG}"/' values-dev.yaml

                git add values-dev.yaml
                git commit -m "Deploy ${params.IMAGE_NAME}:${IMAGE_TAG}"
                git push origin main
                """
            }
        }
    }
}

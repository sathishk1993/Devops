pipeline {
    agent any

    environment {
        IMAGE_NAME = "bankingwebapp"
        ECR_REPO = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${IMAGE_NAME}"
        IMAGE_TAG = "${BUILD_NUMBER}"
        SONAR_HOME = tool 'SonarScanner'
    }

    stages {

        stage('Checkout Application') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/sathishk1993/Devops.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Unit Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('SonarQube Scan') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh """
                    mvn sonar:sonar \
                    -Dsonar.projectKey=${IMAGE_NAME} \
                    -Dsonar.projectName=${IMAGE_NAME}
                    """
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                sh 'trivy fs .'
            }
        }

        stage('Docker Build') {
            steps {
                sh """
                docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                """
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """
                trivy image ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Push Image to Amazon ECR') {
            steps {
                sh """
                aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${ECR_REPO}:${IMAGE_TAG}

                docker push ${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }

        stage('Deploy to Amazon EKS') {
            steps {
                sh """
                kubectl apply -f k8s-manifests/

                kubectl rollout status deployment/bankingapp -n dev --timeout=300s
                """
            }
        }
    }

    post {

        success {
            emailext(
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
Hello Team,

Build Number : ${env.BUILD_NUMBER}
Job Name     : ${env.JOB_NAME}

Application built successfully.
Docker image pushed to Amazon ECR.
Application deployed successfully to Amazon EKS.

Regards,
Jenkins
""",
                to: "team@example.com"
            )
        }

        failure {
            emailext(
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
Hello Team,

Build Number : ${env.BUILD_NUMBER}
Job Name     : ${env.JOB_NAME}

Pipeline execution failed.

Please check the Jenkins Console Output.

Regards,
Jenkins
""",
                to: "team@example.com"
            )
        }

        always {
            cleanWs()
        }
    }
}

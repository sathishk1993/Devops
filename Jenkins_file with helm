pipeline {
    agent {
        label 'jenkinsagent'
    }

    parameters {
        string(name: 'GIT_REPO', description: 'Git repository URL')
        string(name: 'BRANCH', defaultValue: 'main')
        string(name: 'IMAGE_NAME', description: 'Docker/ECR image name')
        string(name: 'RELEASE_NAME', description: 'Helm release name')
        string(name: 'CHART_PATH', defaultValue: './helm/payment')
        string(name: 'NAMESPACE', defaultValue: 'dev')
    }

    environment {
        ECR_REPO = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${params.IMAGE_NAME}"
        IMAGE_TAG = "${BUILD_NUMBER}"
        SONAR_HOME = tool 'SonarScanner'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: "${params.BRANCH}",
                    url: "${params.GIT_REPO}"
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Unit Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('SonarQube Scan') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh """
                    mvn sonar:sonar \
                    -Dsonar.projectKey=${params.IMAGE_NAME} \
                    -Dsonar.projectName=${params.IMAGE_NAME}
                    """
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                sh 'trivy fs .'
            }
        }

        stage('Docker Build') {
            steps {
                sh """
                docker build -t ${params.IMAGE_NAME}:${IMAGE_TAG} .
                """
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """
                trivy image ${params.IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh """
                aws ecr get-login-password --region ${AWS_REGION} |
                docker login --username AWS --password-stdin \
                ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                docker tag ${params.IMAGE_NAME}:${IMAGE_TAG} \
                ${ECR_REPO}:${IMAGE_TAG}

                docker push ${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }

        stage('Deploy to EKS using Helm') {
            steps {
                sh """
                helm upgrade --install ${params.RELEASE_NAME} \
                ${params.CHART_PATH} \
                --namespace ${params.NAMESPACE} \
                --create-namespace \
                --set image.repository=${ECR_REPO} \
                --set image.tag=${IMAGE_TAG} \
                --wait \
                --timeout 5m
                """
            }
        }
    }
}

//values.yaml:

replicaCount: 2

image:
  repository: ""
  tag: ""

service:
  type: ClusterIP
  port: 80
  targetPort: 8080

resources:
  requests:
    cpu: 250m
    memory: 512Mi
  limits:
    cpu: 500m
    memory: 1Gi

//deployment.yaml uses those values:

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Release.Name }}
spec:
  replicas: {{ .Values.replicaCount }}
  selector:
    matchLabels:
      app: {{ .Release.Name }}
  template:
    metadata:
      labels:
        app: {{ .Release.Name }}
    spec:
      containers:
        - name: {{ .Release.Name }}
          image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
          ports:
            - containerPort: {{ .Values.service.targetPort }}



JENKINS PIPELINE PARAMETERS – SIMPLE FLOW

1. Add parameters {} to Jenkinsfile
        ↓
2. Commit and push Jenkinsfile to Git
        ↓
3. Jenkins loads the Jenkinsfile
        ↓
4. Open the Jenkins job
        ↓
5. Click "Build with Parameters"
        ↓
6. Enter/select the required values
        ↓
7. Click "Build"

Jenkins will show:

GIT_REPO       [https://github.com/...]
BRANCH         [main]
IMAGE_NAME     [payment-service]
RELEASE_NAME   [payment]
CHART_PATH     [./helm/payment]
NAMESPACE      [dev]

              [ Build ]

Jenkins then uses these values inside the Jenkinsfile:

params.GIT_REPO
params.BRANCH
params.IMAGE_NAME
params.RELEASE_NAME
params.CHART_PATH
params.NAMESPACE

Example:

params.IMAGE_NAME
        ↓
payment-service

params.RELEASE_NAME
        ↓
payment

params.CHART_PATH
        ↓
./helm/payment

params.NAMESPACE
        ↓
dev

These values are then used by the Jenkins pipeline for Git checkout, Docker/ECR, and Helm deployment.
